@model List<Category>

@{
    ViewData["Title"] = "Categories";
}
<div class="container mt-5">

    <!-- Header + Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">📂 Categories List</h2>

        <a asp-controller="Category" asp-action="Create"
           class="btn btn-success rounded-pill px-4 shadow-sm">
            ➕ Add Category
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <table class="table table-hover text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Category Name</th>
                        <th>Display Order</th>
                        <th>Actions</th> <!-- جديد -->
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-light">
                            <td class="text-dark">@item.Name</td>
                            <td>
                                <span class="badge bg-success p-2">
                                    @item.DisplayOrder
                                </span>
                            </td>

                            <!-- Buttons -->
                            <td>
                                <div class="d-flex justify-content-center gap-2">

                                    <!-- Edit -->
                                    <a asp-controller="Category"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-edit btn-sm px-3">
                                        ✏️ Edit
                                    </a>

                                    <!-- Delete -->
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                        <button class="btn btn-delete btn-sm px-3">
                                            🗑️ Delete
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>