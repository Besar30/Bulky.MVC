@model IEnumerable<Product>

<style>
    .custom-card {
        background-color: #fdf6e3;
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
    }

        .custom-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

    .img-wrapper {
        padding: 0.35cm 0.35cm 0 0.35cm; /* فوق + يمين + شمال */
    }

        .img-wrapper img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 10px;
        }

    .old-price {
        text-decoration: line-through;
        color: gray;
        font-size: 14px;
    }

    .new-price {
        color: #28a745;
        font-weight: bold;
        font-size: 18px;
    }

    .search-container {
        position: relative;
        width: 300px;
    }

    .search-input {
        width: 100%;
        padding: 10px 40px;
        border-radius: 25px;
        border: 1px solid #ccc;
        transition: 0.3s;
    }

        .search-input:focus {
            border-color: #000;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

    .search-icon {
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        color: gray;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-center mb-4">
        <div class="search-container">
            <i class="bi bi-search search-icon"></i>
            <input type="search"
                   class="form-control search-input"
                   placeholder="Search for books..."
                   oninput="GetProduct(this.value)">
        </div>
    </div>
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card custom-card h-100 shadow-sm">

                    <!-- Image -->
                    <div class="img-wrapper">
                        <img src="~/images/Product-@item.Id/@item.Image" />
                    </div>

                    <div class="card-body text-center">

                        <!-- Title -->
                        <h5 class="card-title">@item.Title</h5>

                        <!-- Author -->
                        <p class="text-muted">@item.Author</p>

                        <!-- Prices -->
                        <div>
                            <span class="old-price">List price : $@item.ListPrice</span>
                        </div>
                        <div class="new-price">
                           Price : $@item.Price
                        </div>

                        <!-- Button -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-dark w-100 mt-3">Details</a>

                    </div>

                </div>
            </div>
        }

    </div>
</div>

<script>
    function GetProduct(searchTerm) {
        $.ajax({
            url: '@Url.Action("Index", "Home", new { area = "Customer" })',
            type: 'GET',
            data: { search: searchTerm },
            success: function (result) {

                var html = $(result).find('.row').html();

                $('.row').html(html);
            },
            error: function () {
                console.log("Error");
            }
        });
    }
</script>