@model IEnumerable<Product>

<style>
    .custom-card {
        background-color: #fdf6e3;
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
    }

        .custom-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

    .img-wrapper {
        padding: 0.35cm 0.35cm 0 0.35cm; /* فوق + يمين + شمال */
    }

        .img-wrapper img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 10px;
        }

    .old-price {
        text-decoration: line-through;
        color: gray;
        font-size: 14px;
    }

    .new-price {
        color: #28a745;
        font-weight: bold;
        font-size: 18px;
    }
</style>

<div class="container mt-4">
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card custom-card h-100 shadow-sm">

                    <!-- Image -->
                    <div class="img-wrapper">
                        <img src="~/images/Product/@item.ImageUrl" />
                    </div>

                    <div class="card-body text-center">

                        <!-- Title -->
                        <h5 class="card-title">@item.Title</h5>

                        <!-- Author -->
                        <p class="text-muted">@item.Author</p>

                        <!-- Prices -->
                        <div>
                            <span class="old-price">List price : $@item.ListPrice</span>
                        </div>
                        <div class="new-price">
                           Price : $@item.Price
                        </div>

                        <!-- Button -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-dark w-100 mt-3">Details</a>

                    </div>

                </div>
            </div>
        }

    </div>
</div>