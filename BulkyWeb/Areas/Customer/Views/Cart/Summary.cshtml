@model Bulky.Data.ViewModel.ShoppinCartVM

<form method="post" asp-action="SummaryPost">
    <div class="container mt-5">
        <div class="card shadow border-0" style="background-color:#fdf6e3; border-radius:15px;">

            <!-- Header -->
            <div class="card-header bg-secondary bg-gradient text-light py-4">
                <div class="row px-4">
                    <div class="col-6">
                        <h5 class="pt-2 text-white">Order Summary</h5>
                    </div>
                    <div class="col-6 text-end">
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-danger btn-sm">
                            Back to Cart
                        </a>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="card-body">
                <div class="row g-4">

                    <!-- Shipping Details -->
                    <div class="col-12 col-lg-6">
                        <h4 class="text-info mb-3">Shipping Details:</h4>

                        @* Validation summary عام *@
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Name</label>
                            <div class="col-9">
                                <input asp-for="OrderHeader.Name" class="form-control" required />
                                <span asp-validation-for="OrderHeader.Name" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Phone</label>
                            <div class="col-9">
                                <input asp-for="OrderHeader.PhoneNumber" class="form-control" required />
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Street Address</label>
                            <div class="col-9">
                                <input asp-for="OrderHeader.StreetAddress" class="form-control" required />
                                <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">City</label>
                            <div class="col-9">
                                <input asp-for="OrderHeader.City" class="form-control" required />
                                <span asp-validation-for="OrderHeader.City" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">State</label>
                            <div class="col-9">
                                <input asp-for="OrderHeader.State" class="form-control" required />
                                <span asp-validation-for="OrderHeader.State" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Postal Code</label>
                            <div class="col-9">
                                <input asp-for="OrderHeader.PostalCode" class="form-control" required />
                                <span asp-validation-for="OrderHeader.PostalCode" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <input type="hidden" asp-for="OrderHeader.OrderTolal" class="form-control" required />


                    <!-- Order Summary -->
                    <div class="col-12 col-lg-5 offset-lg-1">
                        <h4 class="text-info mb-3">Order Summary:</h4>
                        <ul class="list-group mb-3">
                            @foreach (var item in Model.ListCart)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="my-0 text-dark">@item.product.Title</h6>
                                        <small class="text-muted">Quantity: @item.Count</small>
                                    </div>
                                    <span class="text-dark">$@item.Price</span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between bg-light">
                                <small class="text-info fw-bold">Total (USD)</small>
                                <strong class="text-info fw-bold">$@Model.OrderHeader.OrderTolal</strong>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>

            <!-- Footer -->
            <div class="card-footer">
                <div class="row align-items-center">
                    <div class="col-12 col-md-8">
                        <p style="color: maroon; font-size:14px;">
                            Estimated Arrival Date: 5-7 business days
                        </p>
                    </div>
                    <div class="col-12 col-md-4">
                        <button type="submit" class="btn btn-primary w-100 py-2">Place Order</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}