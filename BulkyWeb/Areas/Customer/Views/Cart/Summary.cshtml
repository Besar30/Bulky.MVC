<form method="post">
    <div class="container mt-5">
        <div class="card shadow border-0" style="background-color:#fdf6e3; border-radius:15px;">

            <!-- Header -->
            <div class="card-header bg-secondary bg-gradient text-light py-4">
                <div class="row px-4">
                    <div class="col-6">
                        <h5 class="pt-2 text-white">Shopping Cart</h5>
                    </div>
                    <div class="col-6 text-end">
                        <a href="#" class="btn btn-outline-danger btn-sm">
                            Back to Cart
                        </a>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="card-body">
                <div class="row g-4">
                    <!-- Shipping Details -->
                    <div class="col-12 col-lg-6">
                        <h4 class="text-info mb-3">Shipping Details:</h4>
                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Name</label>
                            <div class="col-9">
                                <input name="Name" class="form-control" placeholder="John Doe" required />
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Phone</label>
                            <div class="col-9">
                                <input name="Phone" class="form-control" placeholder="+1 234 567 890" required />
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Street Address</label>
                            <div class="col-9">
                                <input name="StreetAddress" class="form-control" placeholder="123 Main St" required />
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">City</label>
                            <div class="col-9">
                                <input name="City" class="form-control" placeholder="New York" required />
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">State</label>
                            <div class="col-9">
                                <input name="State" class="form-control" placeholder="NY" required />
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-3 col-form-label fw-bold text-dark">Postal Code</label>
                            <div class="col-9">
                                <input name="PostalCode" class="form-control" placeholder="10001" required />
                            </div>
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="col-12 col-lg-5 offset-lg-1">
                        <h4 class="text-info mb-3">Order Summary:</h4>
                        <ul class="list-group mb-3">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="my-0 text-dark">Product 1</h6>
                                    <small class="text-muted">Quantity: 2</small>
                                </div>
                                <span class="text-dark">$50</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="my-0 text-dark">Product 2</h6>
                                    <small class="text-muted">Quantity: 1</small>
                                </div>
                                <span class="text-dark">$30</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between bg-light">
                                <small class="text-info fw-bold">Total (USD)</small>
                                <strong class="text-info fw-bold">$80</strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="card-footer">
                <div class="row align-items-center">
                    <div class="col-12 col-md-8">
                        <p style="color: maroon; font-size:14px;">
                            Estimated Arrival Date: 5-7 business days
                        </p>
                    </div>
                    <div class="col-12 col-md-4">
                        <button type="submit" class="btn btn-primary w-100 py-2">Place Order</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>