@model Bulky.Data.Models.Company

@{
    ViewData["Title"] = "Delete Company";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">

    <div class="card shadow-lg border-0 rounded-4 p-5 text-center" style="max-width:500px; width:100%;">

        <h2 class="text-danger fw-bold mb-3">🗑️ Delete Company</h2>

        <p class="text-muted mb-4">
            Are you sure you want to delete this company? <br>
            <strong>@Model.Name</strong>
        </p>

        <!-- Important Info in Badges -->
        <div class="mb-4 d-flex justify-content-center gap-3 flex-wrap">
            <span class="badge bg-info text-dark p-2">ID: @Model.Id</span>
            @if (!string.IsNullOrEmpty(Model.City))
            {
                <span class="badge bg-warning text-dark p-2">City: @Model.City</span>
            }
            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <span class="badge bg-success p-2">Phone: @Model.PhoneNumber</span>
            }
        </div>

        <!-- Form -->
        <form asp-action="DeleteCompany" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />

            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 py-2 shadow-sm">
                    ⬅ Cancel
                </a>

                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm">
                    ⚠️ Yes, Delete
                </button>
            </div>

        </form>

    </div>
</div>