@model List<Bulky.Data.Models.Company>

@{
    ViewData["Title"] = "Companies";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">🏢 Companies List</h2>

        <a asp-action="Upsert" class="btn btn-success rounded-pill px-4 shadow-sm">
            ➕ Add Company
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <table class="table table-hover text-center align-middle">

                <thead class="table-primary">
                    <tr>
                        <th>Name</th>
                        <th>Street Address</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Postal Code</th>
                        <th>Phone Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-light">

                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-muted">@item.StreetAddress</td>
                            <td>@item.City</td>
                            <td>@item.State</td>
                            <td>@item.PostalCode</td>
                            <td>@item.PhoneNumber</td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Upsert"
                                       asp-route-id="@item.Id"
                                       class="btn btn-edit btn-sm px-3">
                                        ✏️ Edit
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                        <button class="btn btn-delete btn-sm px-3">
                                            🗑️ Delete
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>