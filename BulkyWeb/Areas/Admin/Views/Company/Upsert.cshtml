@model Bulky.Data.Models.Company

@{
    ViewData["Title"] = "Upsert Company";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-secondary bg-gradient py-3 text-center">
            <h2 class="text-white py-2"> @(Model.Id != 0 ? "Update" : "Create") Company</h2>
        </div>

        <div class="card-body p-4">
            <div class="row">

                <!-- Form Column -->
                <div class="col-md-8">
                    <form asp-action="Upsert" method="post">
                        <input asp-for="Id" hidden />

                        <!-- Company Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Company Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter company name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Street Address -->
                        <div class="mb-3">
                            <label asp-for="StreetAddress" class="form-label fw-semibold">Street Address</label>
                            <input asp-for="StreetAddress" class="form-control" placeholder="Enter street address" />
                            <span asp-validation-for="StreetAddress" class="text-danger"></span>
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label asp-for="City" class="form-label fw-semibold">City</label>
                            <input asp-for="City" class="form-control" placeholder="Enter city" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <!-- State -->
                        <div class="mb-3">
                            <label asp-for="State" class="form-label fw-semibold">State</label>
                            <input asp-for="State" class="form-control" placeholder="Enter state" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>

                        <!-- Postal Code -->
                        <div class="mb-3">
                            <label asp-for="PostalCode" class="form-label fw-semibold">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control" placeholder="Enter postal code" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">💾 Save</button>
                            <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 shadow-sm">🔙 Cancel</a>
                        </div>
                    </form>
                </div>

            

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}