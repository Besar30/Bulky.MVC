@model Bulky.Data.Models.Product

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">

    <div class="card shadow-lg border-0 rounded-4 p-5 text-center" style="max-width:500px; width:100%;">

        <h2 class="text-danger fw-bold mb-3">🗑️ Delete Movie</h2>

        <p class="text-muted mb-4">
            Are you sure you want to delete this movie? <br>
            <strong>@Model.Title</strong> by <strong>@Model.Author</strong>
        </p>

        <!-- Important Info in Badges -->
        <div class="mb-4 d-flex justify-content-center gap-3 flex-wrap">
            <span class="badge bg-info text-dark p-2">ID: @Model.Id</span>
            <span class="badge bg-warning text-dark p-2">Price: $@Model.Price</span>
        </div>

        <!-- Form -->
        <form asp-action="DeleteProduct" asp-route-id="@Model.Id" method="post">

            <input asp-for="Id" type="hidden" />

            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 py-2 shadow-sm">
                    ⬅ Cancel
                </a>

                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm">
                    ⚠️ Yes, Delete
                </button>
            </div>

        </form>

    </div>
</div>