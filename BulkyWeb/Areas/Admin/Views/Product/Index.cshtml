@model List<Product>

@{
    ViewData["Title"] = "Books";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">🎬 Books List</h2>

        <a asp-action="Upsert" class="btn btn-success rounded-pill px-4 shadow-sm">
            ➕ Add Movie
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <table class="table table-hover text-center align-middle">

                <thead class="table-primary">
                    <tr>
                        <th>Title</th>
                        <th>Director</th>
                        <th>Price</th>
                        <th>Bulk (50+)</th>
                        <th>Bulk (100+)</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-light">

                            <td class="fw-semibold">@item.Title</td>

                            <td class="text-muted">@item.Author</td>

                            <td>
                                <span class="badge bg-info text-dark p-2">
                                    $@item.Price
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-warning text-dark p-2">
                                    $@item.Price50
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-success p-2">
                                    $@item.Price100
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-success p-2">
                                    @item.category.Name
                                </span>
                            </td>
                            <!-- Actions -->
                            <td>
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-action="Upsert"
                                       asp-route-id="@item.Id"
                                       class="btn btn-edit btn-sm px-3">
                                        ✏️ Edit
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                        <button class="btn btn-delete btn-sm px-3">
                                            🗑️ Delete
                                        </button>
                                    </form>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>