@model OrderVM
<form method="post">
    <input asp-for="orderHeader.Id" type="hidden" />
    <div class="container mt-2">

        <div class="card shadow border-0 rounded-4">

            <!-- Header -->
            <div class="card-header bg-dark text-white d-flex justify-content-between py-1">
                <h4 class="small mb-0">🧾 Order Details</h4>
                <a asp-action="Index" class="btn btn-outline-light btn-sm py-0 px-1">Back</a>
            </div>

            <div class="card-body py-1 px-2">
                <div class="row g-2">

                    <!-- LEFT SIDE -->
                    <div class="col-lg-7">

                        <h5 class="text-primary mb-2 small">Customer Info</h5>

                        <!-- Name -->
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label asp-for="orderHeader.Name"></label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.Name" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.Name" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.Name" readonly class="form-control form-control-sm" />
                                }
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>Phone Number</label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.PhoneNumber" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.PhoneNumber" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.PhoneNumber" readonly class="form-control form-control-sm" />
                                }
                            </div>
                        </div>

                        <!-- Street -->
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>Street Address</label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.StreetAddress" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.StreetAddress" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.StreetAddress" readonly class="form-control form-control-sm" />
                                }
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label asp-for="orderHeader.applicationUser.Email"></label>
                            </div>
                            <div class="col-8">
                                <input type="text" asp-for="orderHeader.applicationUser.Email" readonly class="form-control form-control-sm" />
                            </div>
                        </div>

                        <!-- City, State, Postal -->
                       
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>State</label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.State" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.State" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.State" readonly class="form-control form-control-sm" />
                                }
                            </div>
                        </div>
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>City</label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.City" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.City" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.City"readonly class="form-control form-control-sm" />

                                }
                            </div>
                        </div>
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>Postal Code</label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.PostalCode" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.PostalCode" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.PostalCode" readonly class="form-control form-control-sm" />

                                }
                            </div>
                        </div>
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>Order Date</label>
                            </div>
                            <div class="col-8">
                                <input type="text" value="@Model.orderHeader.OrderDate" readonly class="form-control form-control-sm" />
                            </div>
                        </div>
                        <hr class="my-2" />

                        <h5 class="text-primary mb-2 mt-2 small">Shipping Info</h5>

                        <div class="row mb-1 align-items-center">

                            <div class="col-4 col-form-label small">
                                <label asp-for="orderHeader.Carrier"></label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.Carrier" id="Carrier" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.Carrier" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.Carrier" id="Carrier" class="form-control form-control-sm" readonly />
                                }
                            </div>
                        </div>

                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>Tracking Number</label>
                            </div>
                            <div class="col-8">
                                @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                                {
                                    <input type="text" asp-for="orderHeader.TrackingNumber" id="TrackingNumber" class="form-control form-control-sm" />
                                    <span asp-validation-for="orderHeader.TrackingNumber" class="text-bg-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="orderHeader.TrackingNumber" id="TrackingNumber" class="form-control form-control-sm" readonly />

                                }
                            </div>
                        </div>
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>Shipping Date</label>
                            </div>
                            <div class="col-8">
                               
                                    <input type="text"value="@Model.orderHeader.ShippingDate" class="form-control form-control-sm" readonly />

                                
                            </div>
                        </div>
                       
                        @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                        {
                            <div class="row mb-1 align-items-center">
                                <div class="col-4 col-form-label small">
                                    <label>Session Id</label>
                                </div>
                                <div class="col-8">
                                   
                                        <input type="text" asp-for="orderHeader.SessionId" class="form-control form-control-sm" readonly />

                                    
                                </div>
                            </div>
                            <div class="row mb-1 align-items-center">
                                <div class="col-4 col-form-label small">
                                    <label>Payment Intent Id</label>
                                </div>
                                <div class="col-8">
                                        <input type="text" asp-for="orderHeader.PaymentIntentId" class="form-control form-control-sm" readonly />

                                    
                                </div>
                            </div>
                        }
                        @if (Model.orderHeader.SessionId == null)
                        {
                            <div class="row mb-1 align-items-center">
                                <div class="col-4 col-form-label small">
                                    <label>Payment Due Date</label>
                                </div>
                                <div class="col-8">
                                    <input type="text" value="@Model.orderHeader.PaymentDueDate.ToShortDateString()" class="form-control form-control-sm" readonly />
                                </div>
                            </div>
                        }
                        else
                        {


                            <div class="row mb-1 align-items-center">
                                <div class="col-4 col-form-label small">
                                    <label>Payment Date</label>
                                </div>
                                <div class="col-8">
                                    <input type="text" value="@Model.orderHeader.PaymentDate.ToShortDateString()" class="form-control form-control-sm" readonly />
                                </div>
                            </div>
                        }
                        <!-- Payment info -->
                        <div class="row mb-1 align-items-center">
                            <div class="col-4 col-form-label small">
                                <label>Payment Status</label>
                            </div>
                            <div class="col-8">
                                <input type="text" asp-for="orderHeader.PaymentStatus" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                        {
                            <button type="submit" asp-action="UpdateOrderDetails" class="btn btn-warning btn-sm form-control my-1">Update Order Details</button>
                        }
                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="col-lg-5">

                        <h5 class="text-primary mb-3 small">Order Summary</h5>

                        <span class="badge bg-info mb-3 small">Status: @Model.orderHeader.OrderStatus</span>

                        <ul class="list-group mb-2 small">
                            @foreach (var item in Model.orderDetails)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                    <div>
                                        <h6 class="my-0 text-primary small">Title: @item.Product.Title</h6>
                                        <small class="text-muted">Price: $@item.Price</small><br />
                                        <small class="text-muted">Qty: @item.Count</small>
                                    </div>
                                    <br />
                                    <span class="fw-bold text-success small">Total Product Priec :$@((item.Count * item.Price))</span>
                                </li>
                            }

                            <li class="list-group-item d-flex justify-content-between bg-dark text-white py-2 small">
                                <strong>Total:</strong>
                                <strong>$@Model.orderHeader.OrderTolal</strong>
                                <input asp-for="orderHeader.OrderTolal" type="hidden"/>
                            </li>
                        </ul>

                        <div class="d-grid gap-1">
                            @if(Model.orderHeader.PaymentStatus==SD.PaymentStatusDelayedPayment && Model.orderHeader.OrderStatus == SD.StatusShipped)
                            {
                                <button type="submit" asp-action="Details" class="btn btn-success btn-sm py-1">Pay Now</button>

                            }
                            @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee))
                            {
                                @if (Model.orderHeader.OrderStatus == SD.StatusApproved)
                                {
                                    <button asp-action="StartProcessing" class="btn btn-primary btn-sm py-1">Start Processing</button>

                                }
                                @if (Model.orderHeader.OrderStatus == SD.StatusInProcess)
                                {
                                    <button type="submit" onclick="return validateInput()" asp-action="ShipOrder" class="btn btn-info btn-sm py-1">Ship Order</button>

                                }
                                @if(Model.orderHeader.OrderStatus!=SD.StatusRefunded &&
                                Model.orderHeader.OrderStatus!=SD.StatusCancelled&&
                               Model.orderHeader.OrderStatus != SD.StatusShipped)
                                {
                                    <button type="submit" asp-action="CancelOrder" class="btn btn-danger btn-sm py-1">Cancel Order</button>

                                }
                            }
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        function validateInput(){

            if(document.getElementById("TrackingNumber").value==""){
                Swal.fire({
                    icon:'error',
                    title:'Oops..',
                    text:'please enter tracking number!'
                });
                return false;
            }

            if(document.getElementById("Carrier").value==""){
                Swal.fire({
                    icon:'error',
                    title:'Oops..',
                    text:'please enter Carrier!'
                });
                return false;
            }

            return true;
        }
    </script>
}