@model Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5 text-center">

            <h2 class="text-danger fw-bold mb-4">🗑️ Delete Category</h2>

            <h5 class="mb-4 text-muted">
                Are you sure you want to delete this category?
            </h5>

            <!-- Info -->
            <div class="mb-4">
                <p><strong>ID:</strong> @Model.Id</p>
                <p><strong>Name:</strong> @Model.Name</p>
                <p><strong>Display Order:</strong> @Model.DisplayOrder</p>
            </div>

            <!-- Form -->
            <form asp-action="DeleteCategory" asp-route-id="@Model.Id" method="post">

                <!-- Hidden Id -->
                <input asp-for="Id"  type="hidden" />

                <div class="d-flex justify-content-center gap-3">

                    <!-- Back -->
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                        ⬅ Cancel
                    </a>

                    <!-- Delete -->
                    <button type="submit" class="btn btn-delete px-4">
                        ⚠️ Yes, Delete
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}