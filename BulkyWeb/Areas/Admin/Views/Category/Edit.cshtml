@model Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">

            <h2 class="text-center text-primary fw-bold mb-4">✏️ Edit Category</h2>

            <form asp-action="Edit" method="post">

                <!-- Id (Disabled) -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Id</label>
                    <input value="@Model.Id" class="form-control rounded-3 shadow-sm" disabled />
                </div>

                <!-- Hidden Id (مهم جدا) -->
                <input asp-for="Id" type="hidden" />

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- DisplayOrder -->
                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold"></label>
                    <input asp-for="DisplayOrder" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                        ⬅ Back
                    </a>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        💾 Update
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}