@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-4">
    <div class="row justify-content-center">

        <!-- Register Form -->
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm rounded-4 p-3" style="background-color:#fdf6e3;">
                <h4 class="mb-3 text-center">@ViewData["Title"]</h4>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

                    <!-- Email -->
                    <div class="form-floating mb-2">
                        <input asp-for="Input.Email" class="form-control form-control-sm" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- Name -->
                    <div class="form-floating mb-2">
                        <input asp-for="Input.Name" class="form-control form-control-sm" autocomplete="Name" placeholder="" />
                        <label asp-for="Input.Name">Name</label>
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="form-floating mb-2">
                        <input asp-for="Input.Password" type="password" class="form-control form-control-sm" autocomplete="new-password" placeholder="password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-floating mb-2">
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-sm" autocomplete="new-password" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <!-- Row 1: StreetAddress + City -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Input.StreetAddress" class="form-control form-control-sm" placeholder="" />
                                <label asp-for="Input.StreetAddress">Street Address</label>
                                <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Input.City" class="form-control form-control-sm" placeholder="" />
                                <label asp-for="Input.City">City</label>
                                <span asp-validation-for="Input.City" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: State + PostalCode -->
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Input.State" class="form-control form-control-sm" placeholder="" />
                                <label asp-for="Input.State">State</label>
                                <span asp-validation-for="Input.State" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Input.PostalCode" class="form-control form-control-sm" placeholder="" />
                                <label asp-for="Input.PostalCode">Postal Code</label>
                                <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Phone Number -->
                    <div class="form-floating mb-3">
                        <input asp-for="Input.PhoneNumber" class="form-control form-control-sm" placeholder="" />
                        <label asp-for="Input.PhoneNumber">Phone Number</label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    <!-- Role Selection -->
                    <div class="form-floating mb-3">
                        <select asp-for="Input.Role" id="Input_Role" asp-items="@Model.Input.RoleList" class="form-select form-select-sm">
                            <option value="0" selected disabled>--Select Role--</option>
                        </select>
                        <label asp-for="Input.Role">Role</label>
                    </div>
                    <div class="form-floating mb-3">
                        <select asp-for="Input.CompanyId" style="display:none" asp-items="@Model.Input.CompanyList" class="form-select form-select-sm">
                            <option value="0" selected disabled>--Select Company--</option>
                        </select>
                        <label asp-for="Input.CompanyId">Company</label>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-primary w-100 btn-sm">Register</button>
                </form>
            </div>
        </div>

        <!-- External Logins -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm rounded-4 p-3" style="background-color:#f8f9fa;">
                <h5 class="mb-2 text-center">Or use another service</h5>
                <hr class="my-2" />
                @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <p class="text-muted small mb-0">
                        No external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank">guide</a>.
                    </p>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="d-grid gap-2">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-primary btn-sm" name="provider" value="@provider.Name">
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function(){
            $('#Input_Role').change(function(){
                var selection=$('#Input_Role Option:Selected').text();
                if(selection=='Company'){
                    $('#Input_CompanyId').show();
                }
                else{
                    $('#Input_CompanyId').hide();
                }
            })
        })
    </script>
}